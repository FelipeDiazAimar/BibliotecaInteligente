# Ejemplo de configuración del backend Biblioteca Inteligente.
# Copiar a `.env` y ajustar:  copy .env.example .env   (Windows) / cp .env.example .env (Linux/Mac)
# El .env real NUNCA se commitea (ya está filtrado en .gitignore).

# --- Modo demo (default true si se omite) ---
# true  -> seed idempotente, stubs [demo] para email/OpenRouter, fallbacks sin DB.
# false -> comportamiento original (servicios reales, se exige Postgres + claves).
DEMO_MODE=true

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Base de datos Postgres (vía src/config/config.js + src/models/index.js) ---
# Si se define DATABASE_URL tiene prioridad (conexión con SSL, útil en producción).
# Si no, se usan las partes DB_*.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=biblioteca_dev
DB_NAME_TEST=biblioteca_test
DB_USER=postgres
DB_PASS=postgres
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/biblioteca_dev

# --- Auth (JWT) ---
# En DEMO_MODE sin JWT_SECRET se usa un secreto temporal solo para desarrollo.
# En modo real es OBLIGATORIO: sin él, login/register responden 500 claro.
JWT_SECRET=cambie-este-secreto-por-uno-largo-y-aleatorio

# --- Asistente IA (OpenRouter) ---
# En DEMO_MODE no se llama a OpenRouter (stub [demo] determinístico).
# En modo real es OBLIGATORIO para POST /api/asistente/ask.
OPENROUTER_KEY=sk-or-v1-tu-clave-aqui

# --- Correo (EmailJS) ---
# Reservadas: el envío con @emailjs/browser se hace desde el frontend.
# El backend en DEMO_MODE devuelve stub [demo] vía src/services/emailService.js
# y en modo real informa que no hay proveedor configurado.
EMAILJS_SERVICE_ID=tu-service-id
EMAILJS_TEMPLATE_ID=tu-template-id
EMAILJS_PUBLIC_KEY=tu-public-key

# --- CORS ---
# Orígenes permitidos (coma-separados). El frontend Vite corre en 5173 por defecto.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- Cómo probar esta parte (desde biblioteca-inteligente-backend/) ---
# 1) Diagnóstico de DB (solo lectura, seguro):   node test-db.js
# 2) Seed demo idempotente (no borra nada):       node runSeed.js
# 3) Iniciar el backend:                          node server.js
#    Salud (responde aun sin Postgres):           GET http://localhost:3000/api/health
#    -> { "status": "ok", "demo": true, "hora": "..." }
# Sin Postgres y con DEMO_MODE=true (o sin .env): el servidor igual inicia;
# /api/health responde, GET /api/libros devuelve 5 libros de ejemplo y
# POST /api/asistente/ask devuelve el stub [demo]. El resto responde 503 JSON.
