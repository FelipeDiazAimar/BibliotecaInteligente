# Copiar a .env para desarrollo local: `copy .env.example .env` (Windows) o `cp .env.example .env`
# Modo demo: la app funciona sin backend (datos simulados + fetchConFallback).
VITE_DEMO_MODE=true
# Backend real (biblioteca-inteligente-backend/server.js usa PORT || 3000).
VITE_API_URL=http://localhost:3000
